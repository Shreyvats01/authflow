{
  "name": "@bolkauth/adapter-mongodb",
  "version": "0.1.2",
  "description": "MongoDB adapter for BolkAuth",
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shreyvats01/bolkauth.git",
    "directory": "packages/adapter-mongodb"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run"
  },
  "peerDependencies": {
    "mongodb": "^6.0.0"
  },
  "dependencies": {
    "@bolkauth/core": "workspace:*"
  },
  "devDependencies": {
    "mongodb": "^6.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.3",
    "vitest": "^1.6.1"
  }
}
