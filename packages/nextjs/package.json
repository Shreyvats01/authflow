{
  "name": "@bolkauth/nextjs",
  "version": "0.1.2",
  "description": "Next.js App Router handlers and middleware for BolkAuth",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shreyvats01/bolkauth.git",
    "directory": "packages/nextjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run"
  },
  "peerDependencies": {
    "next": ">=13",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@bolkauth/core": "workspace:*",
    "@bolkauth/react": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
