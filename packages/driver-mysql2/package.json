{
  "name": "@bolkauth/driver-mysql2",
  "version": "0.1.2",
  "description": "MySQL driver helper for BolkAuth wrapping mysql2 and Drizzle ORM",
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shreyvats01/bolkauth.git",
    "directory": "packages/driver-mysql2"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.29.0",
    "mysql2": "^3.0.0"
  },
  "dependencies": {
    "@bolkauth/adapter-drizzle": "workspace:*",
    "@bolkauth/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "drizzle-orm": "^0.29.3",
    "mysql2": "^3.9.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
