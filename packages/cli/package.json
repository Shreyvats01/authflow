{
  "name": "@bolkauth/cli",
  "version": "0.1.1",
  "description": "Interactive CLI setup wizard for BolkAuth",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Shreyvats01/bolkauth"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "bolkauth": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@bolkauth/core": "workspace:*",
    "@clack/prompts": "^0.7.0",
    "chalk": "^5.3.0",
    "detect-package-manager": "^3.0.1",
    "fs-extra": "^11.2.0",
    "ora": "^7.0.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "tsup": "^8.0.0",
    "typescript": "^5.3.3"
  }
}
